# Database
POSTGRES_USER=invitation
POSTGRES_PASSWORD=invitation_secret
POSTGRES_DB=invitation_video
DATABASE_URL=postgresql+asyncpg://invitation:invitation_secret@postgres:5432/invitation_video
# Optional: lets local admin's "Renders Awaiting" page fully act on
# production's manual-render queue (view/claim/cancel/upload), over
# Tailscale for DB/Redis and the public internet for R2. Leave all empty to
# skip — local dev behaves exactly as before.
PROD_DATABASE_URL=
PROD_REDIS_URL=
PROD_S3_ENDPOINT_URL=
PROD_S3_ACCESS_KEY=
PROD_S3_SECRET_KEY=
PROD_S3_BUCKET_NAME=
PROD_S3_REGION=auto
PROD_S3_PUBLIC_URL=
PROD_CDN_BASE_URL=

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO / S3
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET_NAME=invitation-video
S3_REGION=us-east-1

# JWT
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# App
APP_NAME=Bring My Matter
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DEBUG=true

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Google Sign-In (OAuth 2.0 client) — console.cloud.google.com > APIs &
# Services > Credentials. Authorized redirect URI must include
# http://localhost:5173/login-callback (dev) and the prod domain equivalent.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=

# Frontend (Vite)
# Left unset on purpose: the frontend auto-detects the API host from whatever
# hostname the browser used to load the page (localhost, or a LAN IP when
# opened from a phone on the same WiFi). Set this only to force a specific
# API host (e.g. a separate API domain in production).
#VITE_API_URL=http://localhost:8000/api

# Meta WhatsApp Cloud API (customer notifications). Optional — everything
# else works without it; unset just logs what would have been sent.
# META_TOKEN is a System User access token from Meta Business Suite,
# META_PHONE_NUMBER_ID the WABA-registered sending number's id.
META_TOKEN=
META_PHONE_NUMBER_ID=
# "ordered" — sent on successful payment. {{1}} first name, {{2}} order number.
META_WHATSAPP_TEMPLATE_NAME=ordered
META_WHATSAPP_TEMPLATE_LANG=en_US
# "delivery_confirmation" — sent when the render finishes, on every path that
# can complete a job (server worker, local render worker, admin manual upload).
META_WHATSAPP_DELIVERY_TEMPLATE_NAME=delivery_confirmation
META_WHATSAPP_DELIVERY_TEMPLATE_LANG=en_US
