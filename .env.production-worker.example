# Local render worker pointed at PRODUCTION. Copy to .env.production-worker
# (gitignored) and fill in real values — never commit that file.
#
# Usage:
#   docker compose -f docker-compose.local-worker.yml --env-file .env.production-worker up

# Production Postgres, reached over the Tailscale tunnel (not the public
# internet — see docker-compose.prod.yml). Get TAILSCALE_IP from `tailscale
# status` output for the droplet, and the password from the server's own
# /opt/invitation-video/.env (POSTGRES_PASSWORD).
DATABASE_URL=postgresql+asyncpg://invitation:<POSTGRES_PASSWORD>@<TAILSCALE_IP>:5432/invitation_video

# Production Redis, same tunnel. Password from the server's .env (REDIS_PASSWORD).
REDIS_URL=redis://:<REDIS_PASSWORD>@<TAILSCALE_IP>:6379/0

# Production R2 (same bucket the server uses) — public HTTPS, no tunnel needed.
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY=<r2 access key id>
S3_SECRET_KEY=<r2 secret access key>
S3_BUCKET_NAME=<r2 bucket name>
S3_REGION=auto
S3_PUBLIC_URL=https://<r2 public dev URL or custom domain>
CDN_BASE_URL=https://<r2 public dev URL or custom domain>

# Render jobs auto-dispatch to Celery at checkout regardless of DEBUG (see
# payments.py verify_payment) — this worker just needs to be running and
# connected to prod Redis to pick queued jobs up. DEBUG=true here mainly
# controls admin UI details (e.g. showing live progress per job).
DEBUG=true
BACKEND_CORS_ORIGINS=http://localhost:5174,http://localhost:8001
VITE_API_URL=http://localhost:8001/api

# Real production frontend — WhatsApp notification links must point here,
# not localhost, since the customer receiving them is real.
APP_BASE_URL=https://bringmymatter.com

# Same Google OAuth client the server's .env uses — required for the
# "Login" button on this stack's own :5174 frontend to work at all. The
# redirect URI http://localhost:5174/login-callback must also be added to
# the client's Authorized redirect URIs in Google Cloud Console, or Google
# will bounce with redirect_uri_mismatch even with these set correctly.
GOOGLE_CLIENT_ID=<same GOOGLE_CLIENT_ID as the server's .env>
GOOGLE_CLIENT_SECRET=<same GOOGLE_CLIENT_SECRET as the server's .env>
VITE_GOOGLE_CLIENT_ID=<same value as GOOGLE_CLIENT_ID above>

JWT_SECRET_KEY=<same JWT_SECRET_KEY as the server's .env — tokens must validate against the same DB>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

RAZORPAY_KEY_ID=<same as server .env>
RAZORPAY_KEY_SECRET=<same as server .env>
RENDER_PRICE_PAISE=9900

# MSG91 (replaced Twilio) — same values as the server's own .env.
MSG91_AUTH_KEY=<same as server .env>
MSG91_SMS_FLOW_ID=<same as server .env>
MSG91_SMS_SENDER_ID=<same as server .env>
MSG91_WHATSAPP_INTEGRATED_NUMBER=<same as server .env>
MSG91_WHATSAPP_TEMPLATE_NAME=<same as server .env>
MSG91_WHATSAPP_TEMPLATE_NAMESPACE=<same as server .env>

OTP_MOCK=false
OTP_BYPASS_NUMBERS=<same as server .env>

GOOGLE_MAPS_API_KEY=<same as server .env>

APP_NAME=Bring My Matter
SERVER_RENDERING=false
