# Reverse proxy + automatic HTTPS (Let's Encrypt) for production.
# {$DOMAIN} is read from the environment — set DOMAIN=yourdomain.com in the
# production .env on the server. Caddy handles certificate issuance and
# renewal on its own; nothing else to configure for TLS.

{$DOMAIN} {
    # zstd first, gzip fallback — zstd is ~15-20% smaller than gzip on our
    # largest assets and is supported by all current browsers; anything that
    # doesn't advertise it silently gets gzip instead.
    encode zstd gzip

    # Everything the backend owns. /sitemap.xml is generated from published
    # templates (backend/app/api/sitemap.py) and is served at the site root,
    # not under /api — it must be matched here, or the catch-all below hands
    # it to the frontend and the crawler gets the SPA shell instead of XML.
    # A single named matcher is used rather than two `handle` blocks because
    # the bare-path form silently fell through to the frontend.
    @backend path /api/* /sitemap.xml
    handle @backend {
        reverse_proxy backend:8000
    }

    # /editor/{slug} is a client-rendered SPA page — title, canonical and
    # og:image are only set once React mounts and the template loads. Link-
    # preview bots (WhatsApp, Facebook, Twitter, Slack, ...) almost never run
    # JavaScript, so a shared invitation link — the site's main distribution
    # channel — always showed the generic homepage card instead of that
    # template's own name/image. Route just those User-Agents to the
    # backend's server-rendered stand-in (app/api/seo_render.py) instead;
    # every other visitor still gets the real SPA below, untouched.
    @editorBot {
        path /editor/*
        header_regexp User-Agent (?i)(bot|facebookexternalhit|whatsapp|telegrambot|slackbot|discordbot|linkedinbot|twitterbot|pinterest|embedly|quora|redditbot|vkshare|skypeuripreview|applebot|w3c_validator)
    }
    handle @editorBot {
        reverse_proxy backend:8000
    }

    # Same deal for /watch/{id} — the completed-render share page linked from
    # the Copy Link / WhatsApp buttons. Bots get the server-rendered card
    # (app/api/seo_render.py) with the template thumbnail; real visitors get
    # the SPA video player.
    @watchBot {
        path /watch/*
        header_regexp User-Agent (?i)(bot|facebookexternalhit|whatsapp|telegrambot|slackbot|discordbot|linkedinbot|twitterbot|pinterest|embedly|quora|redditbot|vkshare|skypeuripreview|applebot|w3c_validator)
    }
    handle @watchBot {
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy frontend:80
    }
}
