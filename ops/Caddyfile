# Reverse proxy + automatic HTTPS (Let's Encrypt) for production.
# {$DOMAIN} is read from the environment — set DOMAIN=yourdomain.com in the
# production .env on the server. Caddy handles certificate issuance and
# renewal on its own; nothing else to configure for TLS.

{$DOMAIN} {
    # zstd first, gzip fallback — zstd is ~15-20% smaller than gzip on our
    # largest assets and is supported by all current browsers; anything that
    # doesn't advertise it silently gets gzip instead.
    encode zstd gzip

    # Everything the backend owns. /sitemap.xml is generated from published
    # templates (backend/app/api/sitemap.py) and is served at the site root,
    # not under /api — it must be matched here, or the catch-all below hands
    # it to the frontend and the crawler gets the SPA shell instead of XML.
    # A single named matcher is used rather than two `handle` blocks because
    # the bare-path form silently fell through to the frontend.
    @backend path /api/* /sitemap.xml
    handle @backend {
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy frontend:80
    }
}
